# Copy to .env and fill in. .env is never committed.
# DEMO_MODE=1 (default when unset): in-memory DB with random data, no password, no Meta/amoCRM calls.
# Production: DEMO_MODE=0 and fill in everything below.
DEMO_MODE=0

# --- Meta (WhatsApp Cloud API + Marketing API) ---
# System-user token with whatsapp_business_messaging, whatsapp_business_management, ads_read
ACCESS_TOKEN=your-meta-token-here
# Meta app secret: used to verify the X-Hub-Signature-256 of every webhook
APP_SECRET=your-app-secret-here
# Any string; the same value is entered in Meta when subscribing the webhook
VERIFY_TOKEN=your-verify-token-here
GRAPH_VERSION=v23.0

# phone_number_id of the tracked WhatsApp number. Messages to any other number are ignored.
WA_PHONE_NUMBER_ID=000000000000000

# --- dashboard ---
DASHBOARD_PASSWORD=change-me
SESSION_TTL_DAYS=30
# A message after this many silent days opens a new inquiry
INQUIRY_GAP_DAYS=30
TZ_OFFSET_HOURS=5

# --- local run ---
PORT=8000
DB_PATH=data/leads.db

# --- amoCRM ---
AMO_DOMAIN=YOUR_AMO_SUBDOMAIN.amocrm.ru
# Long-lived integration token (amoMarket -> Installed -> Keys and access)
AMO_TOKEN=your-amo-token-here
# off - disabled; dry-run - read amoCRM and log what would be written; on - write
AMO_MODE=dry-run
# Long random string; part of the webhook URL https://DOMAIN/amo/webhook?key=...
AMO_WEBHOOK_KEY=your-random-webhook-key
# IDs of the account, pipeline and custom fields in your amoCRM (placeholders below)
AMO_ACCOUNT_ID=30000000
AMO_PIPELINE_ID=10000000
AMO_SOURCE_FIELD_ID=1000001
AMO_TARGET_ENUM_ID=1000002
AMO_UTM_SOURCE_FIELD_ID=1000011
AMO_UTM_MEDIUM_FIELD_ID=1000012
AMO_UTM_CAMPAIGN_FIELD_ID=1000013
AMO_UTM_CONTENT_FIELD_ID=1000014

# --- aggregated summary for another dashboard (/api/summary, numbers only, no phones) ---
# Empty = endpoint disabled (404)
SUMMARY_KEY=
# Origins allowed to read the summary from the browser (CORS), comma-separated
SUMMARY_ORIGINS=https://eduapp-sales.example.com

# --- server only (docker compose) ---
# Domain with an A record pointing at the server. Caddy obtains the HTTPS certificate itself.
DOMAIN=dashboard.example.com
